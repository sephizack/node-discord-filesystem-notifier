{
  "name": "node-discord-filesystem-notifier",
  "version": "1.1.0",
  "description": "Watch file updates and notify",
  "main": "dist/app.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sephizack/node-discord-filesystem-notifier"
  },
  "dependencies": {
    "@discordjs/rest": "^1.7.0",
    "axios": "^0.27.2",
    "chokidar": "^4.0.1",
    "config": "^3.2.4",
    "discord-api-types": "^0.37.39",
    "discord.js": "^14.9.0",
    "sha1": "^1.1.1"
  },
  "devDependencies": {
    "@types/concurrently": "^4.1.0",
    "@types/jest": "^29.5.0",
    "concurrently": "^5.0.0",
    "jest": "^29.7.0",
    "nock": "^12.0.3",
    "nodemon": "^1.19.2",
    "tslint": "^5.20.1",
    "typescript": "^5.0.4"
  },
  "scripts": {
    "start": "tsc && node dist/src/app.js",
    "build": "tsc  --skipLibCheck",
    "watch-node": "nodemon dist/src/app.js",
    "watch": "concurrently -k \"npm run watch-ts\" \"npm run watch-node\"",
    "watch-ts": "tsc -w",
    "test": "tsc --build --clean && npm run build && jest"
  },
  "author": "Tony Bisegna",
  "license": "MIT"
}
